{
  "name": "@mhaberler/track-parser",
  "version": "0.1.0",
  "description": "Parse GPX, KML, KMZ, GeoJSON, and IGC files into a GPS track with times.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test/parse.test.mjs",
    "example": "vite --config vite.config.js",
    "prepublishOnly": "bun run test && bun run build"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.3",
    "@xmldom/xmldom": "^0.9.12",
    "fflate": "^0.8.3",
    "igc-parser": "^2.0.0",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "leaflet": "1.9.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
