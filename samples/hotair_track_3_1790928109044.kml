<Document>
  <name>Flight Track</name>
  <Style id="yellowLineGreenPoly">
    <LineStyle>
      <color>7f00ffff</color>
      <width>4</width>
    </LineStyle>
    <PolyStyle>
      <color>7f00ff00</color>
    </PolyStyle>
  </Style>
  <!-- Ground track must not share PolyStyle with the extruded 3D path.
       Google Earth (esp. mobile) often treats a LineString that references a
       PolyStyle as a closed ring and draws a straight takeoff↔landing edge. -->
  <Style id="yellowLineGround">
    <LineStyle>
      <color>7f00ffff</color>
      <width>4</width>
    </LineStyle>
  </Style>
  <Style id="start">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/kml/pal4/icon17.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="end">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/kml/pal4/icon48.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="balloonPositionStyle">
    <IconStyle>
      <Icon>
        <href>http://earth.google.com/images/kml-icons/track-directional/track-0.png</href>
      </Icon>
    </IconStyle>
    <LineStyle>
      <color>00ffac59</color>
      <width>4</width>
    </LineStyle>
  </Style>
  <!-- Flytec-parity summary-placemark styles. Distinctive paddle colors per
       metric (green takeoff, red landing, white max-alt, green max-distance,
       blue max-speed, purple max-climb, yellow max-descent, red max-temp) so
       Google Earth renders the same legend as a Flytec Balloon 4 export. -->
  <Style id="hotairSummaryNoIcon">
    <IconStyle><scale>0</scale></IconStyle>
  </Style>
  <Style id="hotairTakeoff">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="hotairLanding">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="hotairMaxAltitude">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-circle-lv.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="hotairMaxDistance">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/grn-circle-lv.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="hotairMaxGroundSpeed">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/blu-circle-lv.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="hotairMaxClimb">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/purple-circle-lv.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="hotairMaxDescent">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/ylw-circle-lv.png</href></Icon>
    </IconStyle>
  </Style>
  <Style id="hotairMaxTemperature">
    <IconStyle>
      <Icon><href>http://maps.google.com/mapfiles/kml/paddle/red-circle-lv.png</href></Icon>
    </IconStyle>
  </Style>

